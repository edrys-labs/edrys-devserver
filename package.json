{
  "name": "@edryslabs/edrys-dev",
  "version": "0.1.0",
  "description": "Develop edrys-Lite labs locally: serves edrys-Lite, syncs on its own port and republishes the class whenever the lab file changes",
  "type": "module",
  "bin": {
    "edrys-dev": "dist/index.js"
  },
  "files": [
    "dist",
    "views"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "tsc && node --test",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "keywords": [
    "edrys",
    "edrys-lite",
    "remote lab",
    "devServer"
  ],
  "license": "MIT",
  "author": "edrys-labs (https://github.com/edrys-labs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edrys-labs/edrys-devserver.git"
  },
  "bugs": {
    "url": "https://github.com/edrys-labs/edrys-devserver/issues"
  },
  "homepage": "https://github.com/edrys-labs/edrys-devserver#readme",
  "dependencies": {
    "@edryslabs/edrys-lite": "3.2.0-dev.0",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "marked": "^18.1.1",
    "msgpackr": "^2.1.2",
    "open": "^10.1.0"
  },
  "optionalDependencies": {
    "@edryslabs/websocket-server": "1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
